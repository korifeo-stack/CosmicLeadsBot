BOT_TOKEN=
CHANNEL_USERNAME=@aicosmicnews
ADMIN_CHAT_ID=
# Optional: if ADMIN_CHAT_ID is empty, send this password from your Telegram account
# to bind your chat_id automatically (example: 1219991)
ADMIN_PASSWORD=
PDF_PATH=./control_service_10min.pdf
# or use PDF_URL instead of PDF_PATH
# PDF_URL=https://example.com/control_service_10min.pdf

# ── Site → Bot HTTP integration ──────────────────────
# Лендинг (cosmicmind.ru) шлёт заявки на этот endpoint:
#   POST http://SITE_LEAD_HOST:SITE_LEAD_PORT/api/site-lead
#   header X-Site-Token: <SITE_LEAD_TOKEN>
#   body: {"name":"...","phone":"...","company":"...","size":"...","source":"...","page":"...","ts":"..."}
# По умолчанию слушает только локалхост — наружу не отдаём.
SITE_LEAD_HOST=127.0.0.1
SITE_LEAD_PORT=8001
# Сгенерируй: openssl rand -hex 32   — должен совпадать с SITE_LEAD_TOKEN на лендинге
SITE_LEAD_TOKEN=
